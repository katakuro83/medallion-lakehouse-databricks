"""
test_data_quality.py

Local unit tests for the DQ framework using a local SparkSession —
no Databricks cluster required. This is what you'd wire into CI
(GitHub Actions) to catch regressions in the quality checks
themselves before they ever run against real data.
"""

import pytest
from pyspark.sql import SparkSession

from src.utils.data_quality import (
    check_not_null,
    check_unique,
    check_accepted_values,
    run_orders_cdc_quality_suite,
)


@pytest.fixture(scope="module")
def spark():
    return (
        SparkSession.builder
        .master("local[2]")
        .appName("dq-tests")
        .getOrCreate()
    )


def test_check_not_null_flags_missing_values(spark):
    df = spark.createDataFrame(
        [("O1", "C1"), ("O2", None)],
        ["order_id", "customer_id"],
    )
    result = check_not_null(df, ["customer_id"])
    assert result.failed_count == 1
    assert result.passed_count == 1


def test_check_unique_flags_duplicates(spark):
    df = spark.createDataFrame(
        [("O1",), ("O1",), ("O2",)],
        ["order_id"],
    )
    result = check_unique(df, "order_id")
    assert result.failed_count == 2  # both rows sharing the duplicate key are flagged
    assert result.passed_count == 1


def test_check_accepted_values_flags_invalid_entries(spark):
    df = spark.createDataFrame(
        [("INSERT",), ("UPSERT",)],  # "UPSERT" is not a valid operation
        ["operation"],
    )
    result = check_accepted_values(df, "operation", {"INSERT", "UPDATE", "DELETE"})
    assert result.failed_count == 1
    assert result.passed_count == 1


def test_full_suite_quarantines_null_customer_id(spark):
    df = spark.createDataFrame(
        [
            ("O1", "C1", "INSERT", 1, "placed"),
            ("O2", None, "INSERT", 1, "placed"),  # should be quarantined
        ],
        ["order_id", "customer_id", "operation", "sequence_num", "order_status"],
    )
    clean_df, quarantine_df = run_orders_cdc_quality_suite(df)

    assert clean_df.count() == 1
    assert quarantine_df is not None
    assert quarantine_df.count() == 1
    assert quarantine_df.collect()[0]["order_id"] == "O2"

# Databricks Workflow definition (Databricks Asset Bundle style)
# Deploy with: databricks bundle deploy
# Or recreate manually as a Workflow in the Databricks UI using these
# task definitions and dependencies.

resources:
  jobs:
    medallion_lakehouse_pipeline:
      name: medallion_lakehouse_pipeline
      schedule:
        quartz_cron_expression: "0 0 6 * * ?"   # daily at 06:00
        timezone_id: "UTC"

      job_clusters:
        - job_cluster_key: main_cluster
          new_cluster:
            spark_version: "15.4.x-scala2.12"
            node_type_id: "Standard_DS3_v2"
            num_workers: 2
            spark_conf:
              spark.databricks.delta.preview.enabled: "true"

      tasks:
        - task_key: bronze_ingest
          job_cluster_key: main_cluster
          spark_python_task:
            python_file: "./src/bronze/ingest_bronze.py"

        - task_key: silver_apply_cdc
          depends_on:
            - task_key: bronze_ingest
          job_cluster_key: main_cluster
          spark_python_task:
            python_file: "./src/silver/apply_cdc_silver.py"

        - task_key: gold_aggregates
          depends_on:
            - task_key: silver_apply_cdc
          job_cluster_key: main_cluster
          spark_python_task:
            python_file: "./src/gold/build_gold_aggregates.py"

      email_notifications:
        on_failure:
          - data-engineering@example.com
